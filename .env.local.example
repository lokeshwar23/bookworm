# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bookworm

# JWT signing secret — use a long random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Full URL of the running app (used for absolute links / CORS)
NEXT_PUBLIC_APP_URL=
